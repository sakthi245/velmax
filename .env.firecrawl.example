# Firecrawl Self-Hosted Configuration
# Copy this to .env.firecrawl and customize

# ==========================================
# LLM Configuration (for Extract, Agent, Search, Map)
# ==========================================
# Groq API (Free tier: 14,400 req/day) - RECOMMENDED
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=groq/compound

# Alternative: LocalAI
# OPENAI_BASE_URL=http://host.docker.internal:8080/v1
# OPENAI_API_KEY=local
# OPENAI_MODEL=llama3.1

# Alternative: vLLM
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# OPENAI_API_KEY=vllm
# OPENAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ==========================================
# Firecrawl API Settings
# ==========================================
# Disable authentication for local development
USE_DB_AUTHENTICATION=false

# Queue backend (must be 'pg' or 'fdb')
NUQ_BACKEND=pg

# Concurrency settings (optimized for 3.48GB Docker VM)
CRAWL_CONCURRENT_REQUESTS=1
MAX_CONCURRENT_JOBS=1
BROWSER_POOL_SIZE=1
NUM_WORKERS_PER_QUEUE=1

# ==========================================
# Optional: External Search (SearXNG)
# ==========================================
# SEARXNG_ENDPOINT=http://host.docker.internal:8080

# ==========================================
# Optional: Proxy Configuration
# ==========================================
# PROXY_SERVER=http://proxy:port
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass

# ==========================================
# Database (PostgreSQL)
# ==========================================
# These are set in docker-compose.firecrawl.yml
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres