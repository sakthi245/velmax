#!/usr/bin/env python3
"""
Generated Crawlee Crawler for {{ profile.url }}
"""

import asyncio
import json
import logging
from dataclasses import dataclass, asdict
from typing import Dict, Any, List, Optional
from crawlee.crawlers import PlaywrightCrawler
from crawlee.proxy_configuration import ProxyConfiguration
from crawlee.sessions import SessionPool
from datetime import timedelta

logger = logging.getLogger(__name__)


@dataclass
class ScrapedItem:
    url: str
    title: str = ""
    content: str = ""
    data: Dict[str, Any] = None
    metadata: Dict[str, Any] = None

    def __post_init__(self):
        if self.data is None:
            self.data = {}
        if self.metadata is None:
            self.metadata = {}


class {{ profile.category | capitalize }}CrawleeCrawler:
    def __init__(self, config: Dict[str, Any] = None):
        self.config = config or {}
        self.crawler: Optional[PlaywrightCrawler] = None
        self.results: List[ScrapedItem] = []

        self.headless = {{ config.managed_engine.headless | lower }}
        self.browser_type = "{{ config.managed_engine.browser_type }}"
        self.max_requests = {{ config.managed_engine.max_requests_per_crawl }}
        self.max_concurrency = {{ config.managed_engine.max_concurrency }}
        self.session_pool_size = {{ config.managed_engine.session_pool_size }}
        self.rpm = {{ config.managed_engine.rpm }}

    async def initialize(self):
        """Initialize crawler with session pool and proxy"""
        proxy_config = ProxyConfiguration(
            proxy_urls={{ config.managed_engine.proxy_tiers | tojson }},
        )

        session_pool = SessionPool(
            max_pool_size=self.session_pool_size,
            create_session_settings={
                "max_usage_count": {{ config.managed_engine.session_max_usage }},
                "max_age": timedelta(hours={{ config.managed_engine.session_max_age_hours }}),
                "blocked_status_codes": {{ config.managed_engine.blocked_status_codes | tojson }},
            }
        )

        self.crawler = PlaywrightCrawler(
            proxy_configuration=proxy_config,
            use_session_pool=True,
            session_pool=session_pool,
            max_requests_per_crawl=self.max_requests,
            headless=self.headless,
            browser_type=self.browser_type,
        )

        @self.crawler.router.default_handler
        async def handler(context):
            await self._handle_page(context)

    async def _handle_page(self, context):
        page = context.page
        await page.wait_for_load_state("networkidle")

        html = await page.content()
        title = await page.title()

        # Extract using selectors
        selectors = {{ selectors | tojson }}

        item = ScrapedItem(url=context.request.url, title=title, content=html[:5000])

        for field_name, selector_config in selectors.items():
            if isinstance(selector_config, list):
                selector_config = selector_config[0] if selector_config else {}

            sel = selector_config.get("selector", "")
            attr = selector_config.get("attribute")
            multiple = selector_config.get("multiple", False)

            try:
                if multiple:
                    elements = await page.query_selector_all(sel)
                    values = []
                    for el in elements:
                        if attr:
                            val = await el.get_attribute(attr)
                        else:
                            val = await el.inner_text()
                        if val:
                            values.append(val.strip())
                    item.data[field_name] = values
                else:
                    el = await page.query_selector(sel)
                    if el:
                        if attr:
                            val = await el.get_attribute(attr)
                        else:
                            val = await el.inner_text()
                        if val:
                            item.data[field_name] = val.strip()
            except Exception as e:
                logger.warning(f"Failed to extract {field_name}: {e}")

        item.metadata = {
            "scraped_at": datetime.utcnow().isoformat(),
            "engine": "crawlee",
        }

        self.results.append(item)

        # Enqueue links if follow_links enabled
        if {{ config.managed_engine.follow_links | lower }}:
            await context.enqueue_links()

    async def run(self, urls: List[str]):
        await self.crawler.run(urls)

    async def get_results(self) -> List[ScrapedItem]:
        return self.results


async def main(request_data: Dict[str, Any] = None) -> Dict[str, Any]:
    if request_data is None:
        request_data = {}

    urls = request_data.get("urls", ["{{ profile.url }}"])

    crawler = {{ profile.category | capitalize }}CrawleeCrawler()
    await crawler.initialize()
    await crawler.run(urls)
    results = await crawler.get_results()

    return {
        "success": True,
        "url": urls[0] if urls else "",
        "data": [asdict(r) for r in results],
        "engine_used": "crawlee",
    }


if __name__ == "__main__":
    import sys
    import json

    request_file = None
    output_file = None

    for i, arg in enumerate(sys.argv):
        if arg == "--request" and i + 1 < len(sys.argv):
            request_file = sys.argv[i + 1]
        elif arg == "--output" and i + 1 < len(sys.argv):
            output_file = sys.argv[i + 1]

    if request_file:
        with open(request_file) as f:
            request_data = json.load(f)
    else:
        request_data = {}

    result = asyncio.run(main(request_data))

    if output_file:
        with open(output_file, "w") as f:
            json.dump(result, f, indent=2)
    else:
        print(json.dumps(result, indent=2))