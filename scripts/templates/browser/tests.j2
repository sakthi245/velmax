import pytest
from unittest.mock import AsyncMock, Mock, patch
from main import {{ profile.category | capitalize }}BrowserScraper, ScrapedItem


@pytest.fixture
def scraper():
    return {{ profile.category | capitalize }}BrowserScraper()


@pytest.mark.asyncio
async def test_scraper_start(scraper):
    """Test browser starts correctly"""
    with patch("playwright.async_api.async_playwright") as mock_pw:
        mock_browser = AsyncMock()
        mock_context = AsyncMock()
        mock_page = AsyncMock()

        mock_pw.return_value.__aenter__.return_value = mock_pw.return_value
        mock_pw.return_value.chromium.launch.return_value = mock_browser
        mock_browser.new_context.return_value = mock_context
        mock_context.new_page.return_value = mock_page

        async with scraper:
            assert scraper.browser is not None
            assert scraper.context is not None
            assert scraper.page is not None


