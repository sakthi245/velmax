@pytest.mark.asyncio
async def test_interact_sequence(scraper):
    """Test interaction sequence execution"""
    with patch("playwright.async_api.async_playwright") as mock_pw:
        mock_browser = AsyncMock()
        mock_context = AsyncMock()
        mock_page = AsyncMock()

        mock_pw.return_value.__aenter__.return_value = mock_pw.return_value
        mock_pw.return_value.chromium.launch.return_value = mock_browser
        mock_browser.new_context.return_value = mock_context
        mock_context.new_page.return_value = mock_page
        mock_page.click = AsyncMock()
        mock_page.fill = AsyncMock()
        mock_page.hover = AsyncMock()

        sequence = [
            {"action": "click", "selector": ".button"},
            {"action": "fill", "selector": ".input", "text": "test"},
        ]

        async with scraper:
            result = await scraper.interact(sequence)

        assert "success" in result
        assert "steps" in result


