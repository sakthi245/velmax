#!/usr/bin/env python3
"""
Generated Firecrawl Script for {{ profile.url }}
Generated at: {{ timestamp }}
Profile: {{ profile.category }} | Anti-bot: {{ profile.anti_bot_level }}
"""

import asyncio
import json
import logging
import time
from dataclasses import dataclass, asdict
from typing import Dict, Any, List, Optional
import httpx
from datetime import datetime

logger = logging.getLogger(__name__)


@dataclass
class ScrapedItem:
    url: str
    title: str = ""
    content: str = ""
    data: Dict[str, Any] = None
    metadata: Dict[str, Any] = None

    def __post_init__(self):
        if self.data is None:
            self.data = {}
        if self.metadata is None:
            self.metadata = {}


class {{ profile.category | capitalize }}FirecrawlClient:
    def __init__(self, config: Dict[str, Any] = None):
        self.config = config or {}
        self.client: Optional[httpx.AsyncClient] = None
        self.results: List[ScrapedItem] = []

        self.base_url = "{{ profile.url }}"
        self.endpoints = {{ profile.api_endpoints | tojson }}
        self.auth_method = "{{ profile.auth_type or 'none' }}"
        self.rate_limit = {{ config.api_engine.rate_limit_per_endpoint }}

    async def __aenter__(self):
        await self.start()
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb):
        await self.close()

    async def start(self):
        """Initialize HTTP client for Firecrawl API"""
        self.client = httpx.AsyncClient(
            base_url="{{ config.cloud_engine.api_url }}",
            timeout=httpx.Timeout(
                connect=10.0,
                read={{ config.cloud_engine.timeout / 1000 }},
                write=30.0,
                pool=5.0,
            ),
            headers={
                "Authorization": "Bearer {{ config.cloud_engine.api_key }}",
                "Content-Type": "application/json",
            },
        )

        # Test connection
        await self._test_connection()

    async def _test_connection(self):
        """Test Firecrawl API connection"""
        try:
            response = await self.client.get("/health")
            if response.status_code == 200:
                logger.info("Firecrawl API connection successful")
            else:
                logger.warning("Firecrawl API health check failed", status=response.status_code)
        except Exception as e:
            logger.warning("Firecrawl API connection failed", error=str(e))

    async def close(self):
        if self.client:
            await self.client.aclose()

    async def scrape(self) -> List[ScrapedItem]:
        """Scrape data using Firecrawl"""
        self.results = []

        urls = ["{{ profile.url }}"]  # Can be extended for multiple URLs

        for url in urls:
            try:
                item = await self._scrape_url(url)
                if item:
                    self.results.append(item)
            except Exception as e:
                logger.error(f"Failed to scrape {url}: {e}")

        return self.results

    async def _scrape_url(self, url: str) -> Optional[Dict]:
        """Scrape a single URL using Firecrawl"""
        payload = {
            "url": url,
            "formats": {{ config.cloud_engine.formats | tojson }},
            "onlyMainContent": {{ config.cloud_engine.only_main_content | lower }},
            "proxy": "{{ config.cloud_engine.proxy }}",
            "timeout": {{ config.cloud_engine.timeout }},
        }

        if "{{ config.cloud_engine.wait_for_selector }}":
            payload["waitForSelector"] = "{{ config.cloud_engine.wait_for_selector }}"

        if {{ config.cloud_engine.wait_for_timeout }}:
            payload["waitFor"] = {{ config.cloud_engine.wait_for_timeout }}

        if {{ config.cloud_engine.screenshot | lower }}:
            payload["screenshot"] = True

        if {{ config.cloud_engine.pdf | lower }}:
            payload["pdf"] = True

        if {{ config.cloud_engine.extract_with_llm | lower }} and "{{ config.cloud_engine.llm_schema }}":
            payload["extract"] = {
                "schema": {{ config.cloud_engine.llm_schema | tojson }},
                "prompt": "{{ config.cloud_engine.llm_prompt or 'Extract structured data from the page' }}",
            }

        # Execute with retry
        retryer = self._create_retryer()

        async def _do_scrape():
            response = await self.client.post("/v1/scrape", json=payload)
            response.raise_for_status()
            return response.json()

        result = await self._execute_with_retry(_do_scrape)

        # Parse result
        data = result.get("data", {})
        markdown = data.get("markdown")
        html = data.get("html")
        metadata = data.get("metadata", {})

        # Handle LLM extraction
        extracted = None
        if {{ config.cloud_engine.extract_with_llm | lower }}:
            extracted = data.get("extract")

        return {
            "url": url,
            "title": metadata.get("title", ""),
            "html": html,
            "text": markdown or "",
            "markdown": markdown,
            "metadata": {
                **metadata,
                "extracted": extracted,
                "source": "firecrawl",
            },
        }

    def _create_retryer(self):
        from ..utils.retry import create_retry_policy
        return create_retry_policy(
            max_attempts=3,
            base_delay=2.0,
            max_delay=60.0,
            retryable_status_codes={408, 429, 500, 502, 503, 504},
            retryable_exceptions=["TimeoutError", "ConnectionError", "ConnectTimeout", "ReadTimeout"],
        )

    async def _execute_with_retry(self, coro_func):
        retryer = self._create_retryer()
        try:
            return await retryer(coro_func)
        except Exception as e:
            raise e


async def main(request_data: Dict[str, Any] = None) -> Dict[str, Any]:
    if request_data is None:
        request_data = {}

    client = {{ profile.category | capitalize }}FirecrawlClient()
    async with client:
        results = await client.scrape()

    return {
        "success": True,
        "url": "{{ profile.url }}",
        "data": results,
        "engine_used": "firecrawl",
    }


if __name__ == "__main__":
    import sys
    import json

    request_file = None
    output_file = None

    for i, arg in enumerate(sys.argv):
        if arg == "--request" and i + 1 < len(sys.argv):
            request_file = sys.argv[i + 1]
        elif arg == "--output" and i + 1 < len(sys.argv):
            output_file = sys.argv[i + 1]

    if request_file:
        with open(request_file) as f:
            request_data = json.load(f)
    else:
        request_data = {}

    result = asyncio.run(main(request_data))

    if output_file:
        with open(output_file, "w") as f:
            json.dump(result, f, indent=2)
    else:
        print(json.dumps(result, indent=2))