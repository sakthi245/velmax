def test_parse_list_page(spider, sample_html):
    """Test parsing list page extracts items"""
    response = HtmlResponse(
        url="{{ profile.url }}",
        body=sample_html.encode(),
        encoding="utf-8",
    )

    items = list(spider.parse(response))

    assert len(items) > 0
    for item in items:
        assert hasattr(item, "url")
        assert hasattr(item, "data")
        assert "title" in item.data or "price" in item.data


def test_extract_single_item(spider, sample_html):
    """Test single item extraction"""
    response = HtmlResponse(
        url="{{ profile.url }}",
        body=sample_html.encode(),
        encoding="utf-8",
    )

    # Get first product container
    container = response.css(".product").get()
    item = spider._extract_single_item(response, container)

    assert item.url == "{{ profile.url }}"
    assert "title" in item.data
    assert "price" in item.data


