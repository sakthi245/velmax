# Integration test (requires network)
@pytest.mark.integration
def test_spider_integration(spider):
    """Integration test - requires network access"""
    from scrapy.crawler import CrawlerProcess
    from scrapy.utils.project import get_project_settings

    process = CrawlerProcess(get_project_settings())
    results = []

    def collect(item):
        results.append(item)

    original_parse = spider.parse
    def parse_wrapper(self, response):
        for item in original_parse(self, response):
            collect(item)
            yield item

    spider.parse = parse_wrapper.__get__(spider, type(spider))

    process.crawl(type(spider))
    process.start()

    assert len(results) > 0


